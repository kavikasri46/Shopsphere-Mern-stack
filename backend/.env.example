# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URL (Local or MongoDB Atlas)
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere
# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shopsphere?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (for CORS and Socket.IO origin configuration)
FRONTEND_URL=http://localhost:5173
