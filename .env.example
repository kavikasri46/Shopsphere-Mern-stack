# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shopsphere?retryWrites=true&w=majority

# JWT Secret Key for token authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (optional, defaults to same domain on Vercel or localhost)
FRONTEND_URL=https://your-project.vercel.app

# Optional: Set custom API URL if frontend is deployed separately from backend
# VITE_API_URL=https://your-backend.vercel.app/api

# Optional: Set external Socket server if using real-time WebSockets in production
# VITE_SOCKET_URL=https://your-socket-server.onrender.com

# Node Environment
NODE_ENV=production
